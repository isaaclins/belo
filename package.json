{
  "name": "belo",
  "version": "0.11.2",
  "packageManager": "npm@11.11.0",
  "description": "Local image classifier trainer",
  "scripts": {
    "dev": "npm run assets && vite",
    "build": "npm run assets && tsc --noEmit && vite build",
    "preview": "vite preview",
    "assets": "node scripts/copy-wasm.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "check:version": "node scripts/check-version.mjs",
    "check:camera": "node scripts/check-camera-seam.mjs",
    "check:boxes": "node scripts/check-boxes.mjs",
    "check:detect": "node scripts/check-detect.mjs",
    "check:curve": "node scripts/check-curve.mjs",
    "check:learning": "node scripts/check-learning.mjs",
    "check:store": "node scripts/check-store.mjs",
    "eval:real": "node scripts/eval-real.mjs",
    "og": "node scripts/make-og.mjs",
    "icons": "node scripts/make-icon.mjs master && tauri icon src-tauri/app-icon.png --ios-color '#ffd83d' && node scripts/make-icon.mjs ios",
    "tauri": "tauri",
    "check:overlay": "node scripts/check-overlay.mjs",
    "check:propose": "node scripts/check-propose.mjs",
    "check:camera-live": "node scripts/check-camera-live.mjs",
    "check:screen": "node scripts/check-screen.mjs",
    "check:export": "node scripts/check-export.mjs",
    "check:selection": "node scripts/check-selection.mjs",
    "check:snip": "node scripts/check-snip.mjs",
    "check:adaptive": "node scripts/check-adaptive.mjs",
    "check:hud": "node scripts/check-hud.mjs",
    "check:hud-real": "node scripts/check-hud-real.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isaaclins/belo.git"
  },
  "license": "MIT",
  "type": "module",
  "private": true,
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jpeg-js": "^0.4.4",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
